@startuml
class Libro {
    + Libro()
    + Libro(id:int, titulo:string, autor:string, fechaLanzamiento:DateTime, editorial:Editorial, precioReposicion:decimal, precioCompra:decimal, stock:int, genero:Genero)
    + Id : int <<get>> <<set>>
    + Titulo : string <<get>> <<set>>
    + TipoLibro : string <<get>> <<set>>
    + FechaLanzamiento : DateTime <<get>> <<set>>
    + Autor : string <<get>> <<set>>
    + CalificacionMedia : decimal <<get>> <<set>>
    + PrecioReposicion : decimal <<get>> <<set>>
    + Stock : int <<get>> <<set>>
    + PrecioCompra : decimal <<get>> <<set>>
}
Libro "0..*" -- "1" Genero : Genero
Libro "0..*" -- "1" Editorial : Editorial
@enduml
