@startuml
class Reposicion {
    + Reposicion()
    + Reposicion(id:int, fechaReposicion:DateTime, metodoPago:MetodoPago, reposicionItems:IList<ReposicionItem>, comentario:string)
    + Reposicion(id:int, fechaReposicion:DateTime, metodoPago:MetodoPago, reposicionItems:IList<ReposicionItem>)
    + Id : int <<get>> <<set>>
    + PrecioTotal : decimal <<get>> <<set>>
    + Comentario : string? <<get>> <<set>>
}
Reposicion --> "MetodoPago" MetodoPago
Reposicion "0..*" -- "1" ApplicationUser : Usuario
@enduml
