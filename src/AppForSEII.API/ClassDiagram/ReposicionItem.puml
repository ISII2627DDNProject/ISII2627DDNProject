@startuml
class ReposicionItem {
    + ReposicionItem()
    + ReposicionItem(libro:Libro, reposicion:Reposicion, cantidad:int)
    + LibroId : int <<get>> <<set>>
    + ReposicionId : int <<get>> <<set>>
    + Cantidad : int <<get>> <<set>>
    + Precio : decimal <<get>> <<set>>
}
ReposicionItem "0..*" -- "1" Libro : Libro
Reposicion "1" *-- "1..*" ReposicionItem : ReposicionItems
@enduml
